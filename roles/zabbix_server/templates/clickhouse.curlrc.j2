silent
show-error
fail
max-time = 60
{% if not (_clickhouse_connection.ssl_verify_peer | bool or _clickhouse_connection.ssl_verify_host | bool) %}
insecure
{% endif %}
{% set options = {
    'user': ((_clickhouse_connection.username or '') ~ ':' ~ (_clickhouse_connection.password or ''))
        if _clickhouse_connection.username or _clickhouse_connection.password else none,
    'interface': _clickhouse_connection.source_ip or none,
    ('capath' if _zabbix_server_clickhouse_ca.stat.isdir | default(false) else 'cacert'): _clickhouse_connection.ssl_ca_location or none,
    'cert': ([_clickhouse_connection.ssl_cert_location or '', _clickhouse_connection.ssl_cert_file] | path_join)
        if _clickhouse_connection.ssl_cert_file else none,
    'key': ([_clickhouse_connection.ssl_key_location or '', _clickhouse_connection.ssl_key_file] | path_join)
        if _clickhouse_connection.ssl_key_file else none,
    'pass': _clickhouse_connection.ssl_key_password or none,
} %}
{% for option, value in options.items() if value is not none %}
{{ option }} = "{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') | replace('\n', '\\n') | replace('\r', '\\r') }}"
{% endfor %}
